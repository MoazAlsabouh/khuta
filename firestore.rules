rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // المناهج والدروس متاحة للقراءة لجميع الطلاب، والكتابة للمسجلين/المشرفين
    match /lessons/{lessonId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // المستخدمين، التقدم، الامتحانات، القنوات، والمهام: متاحة للمستخدمين المسجلين
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
